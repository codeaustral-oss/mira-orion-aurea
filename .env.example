# Never commit credentials. Keys live in the shell environment (or in the
# deployed proxy's environment), never on the device and never in this repo.

# Jev (System One) by TypeSafe AI — the decision label. Optional: without it the proxy falls
# back to deterministic rules and says so.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Mira's agent model, reached directly over the OpenCode Go Responses API.
# The Swift app never sees this key; only the proxy process does.
OPENCODE_GO_API_KEY=
MIRA_AGENT_MODEL=muse-spark-1.3-contributor
MIRA_AGENT_REASONING=xhigh

# The key the deployed proxy asks every /v1/* caller for. With it set, requests
# must carry the x-mira-key header (`scripts/point-app.sh` writes that value
# into an installed bundle); with it unset the proxy is the open local
# development server. /health never requires it.
MIRA_PROXY_KEY=

# Optional overrides
PORT=8791
HOST=127.0.0.1
# Where the durable simulated relay ledger is written. Defaults to
# .build/relay/ledger.json under the repo root.
# MIRA_RELAY_PATH=

# The prototype is simulated money. This must not be changed to imply a real
# transfer, a real account or a real yield product.
MIRA_FINANCIAL_MODE=SIMULATED
